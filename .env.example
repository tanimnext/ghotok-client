# Copy to .env.local for development. NEXT_PUBLIC_* values are compiled into the
# browser bundle at build time: never put a secret in them.

# ---- Database and sign-in (Better Auth runs in this app) ----
# MUST be the same database as ghotok-server's MONGODB_URI: accounts, sessions and payments
# written here are read by the API.
MONGODB_URI=mongodb://127.0.0.1:27017/ghotok
# MUST be the same value as ghotok-server's BETTER_AUTH_SECRET (it checks the session cookie).
# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=dev-better-auth-secret-change-me-0123456789
# This website's public URL (where /api/auth lives).
BETTER_AUTH_URL=http://localhost:3000

# Where the Next.js server forwards the rest of /api (ghotok-server). Used at build time for
# the /api rewrite and at run time for server-side data fetching.
API_URL=http://localhost:4000

# Public URL of this website (SEO metadata, sitemap, SSLCommerz return and IPN URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default language for first-time visitors: en or bn.
NEXT_PUBLIC_DEFAULT_LANG=en

# ImgBB API key (https://api.imgbb.com/) for image uploads from the browser
# (support attachments, report attachments, admin banners). Without it those
# uploads show "not set up". The key is visible to visitors; ImgBB keys only
# allow uploading, but create a separate ImgBB account for the site.
NEXT_PUBLIC_IMGBB_API_KEY=

# ---- Payments: SSLCommerz (the only way to pay) ----
# Cards, bKash, Nagad, Rocket and internet banking on SSLCommerz's page. Get a sandbox store at
# https://developer.sslcommerz.com/registration/ . Until this is set, buying connections is off.
# Production: SSLCOMMERZ_BASE_URL=https://securepay.sslcommerz.com
SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
